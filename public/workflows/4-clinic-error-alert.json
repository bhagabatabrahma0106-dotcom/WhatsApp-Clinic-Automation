{
  "name": "Clinic Error Alert - Workflow 4",
  "nodes": [
    {
      "parameters": {},
      "id": "error-trigger-node",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "toEmail": "<OWNER_EMAIL>",
        "subject": "=Clinic workflow failed: {{ $json.workflow.name }}",
        "emailType": "text",
        "message": "=Workflow: {{ $json.workflow.name }}\nExecution ID: {{ $json.execution.id }}\nURL: {{ $json.execution.url }}\nError: {{ $json.execution.error.message }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "send-error-alert-gmail",
      "name": "Send Error Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [480, 300]
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Send Error Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Asia/Kolkata"
  }
}
